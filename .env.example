# LLM provider (OpenAI-compatible). Defaults to DeepSeek (cheap, good for classification).
# Get a key at https://platform.deepseek.com
T2T_LLM_API_KEY=your-deepseek-api-key
T2T_LLM_BASE_URL=https://api.deepseek.com
T2T_LLM_MODEL=deepseek-chat

# Optional: cheaper/faster model for bulk classification steps
T2T_LLM_FAST_MODEL=deepseek-chat

# Langfuse snapshot pull (Supported: Cloud/self-hosted v4 Public API v2 flow)
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com
